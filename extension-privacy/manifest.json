{
  "manifest_version": 2,
  "name": "Privacy Invasion Detector",
  "version": "1.0",

  "description": "Extensão para detectar ataques e invsão de privacidade do cliente Web no FireFox",

  "icons": {
    "48": "icons/track-img.png"
  },

  "permissions": [
      "tabs",
      "cookies",
      "storage",
      "webRequest",
      "<all_urls>"
  ],

  "background": {
    "scripts": [
      "src/cookies.js",
      "src/thirdDomains.js",
      "src/localStorage.js"
    ]
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/localStorageData.js"]
    }
  ],

  "browser_action": {
      "default_title": "Privacy Invasion Detector",
      "default_popup": "popup.html"
  }
}