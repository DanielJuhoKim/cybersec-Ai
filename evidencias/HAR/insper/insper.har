            "text": "<!--\n* Copyright 2020 Adobe. All rights reserved.\n* This file is licensed to you under the Apache License, Version 2.0 (the \"License\");\n* you may not use this file except in compliance with the License. You may obtain a copy\n* of the License at http://www.apache.org/licenses/LICENSE-2.0\n*\n* Unless required by applicable law or agreed to in writing, software distributed under\n* the License is distributed on an \"AS IS\" BASIS, WITHOUT WARRANTIES OR REPRESENTATIONS\n* OF ANY KIND, either express or implied. See the License for the specific language\n* governing permissions and limitations under the License.\n-->\n<!DOCTYPE html>\n<html lang=\"pt\">\n  <head>\n    <meta charset=\"UTF-8\"/>\n    <title>Insper: Ensino Superior em Negócios, Direito, Engenharias e Ciência da Computação</title>\n    \n    <meta name=\"description\" content=\"Cursos de graduação, pós-graduação e curta duração com qualidade reconhecida internacionalmente\"/>\n    \n\n\n\n    <meta name=\"template\" content=\"spa-page-template\"/>\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/>\n    \n\n    \n    \n<meta name=\"content-page-ref\" content=\"bQgmqj1zhmlu4AiOPlLF37c1E3H4e-iACUDHJLfdKeVMC3OU7Pjw6kZrTGEYJUHTTVZHOSG-4cf70PWyJZufKg\"/>\n<script defer=\"defer\" type=\"text/javascript\" src=\"/.rum/@adobe/helix-rum-js@%5E2/dist/micro.js\"></script>\n<link rel=\"canonical\" href=\"https://www.insper.edu.br/content/insper-portal/pt/home.html\"/>\n\n    \n\n    \n\n\n  <noscript>\n    <div style=\"display: none;\">\n      [{\"subtitle\":\"Insper - Home Page\",\"jcr:title\":\"Insper: Ensino Superior em Negócios, Direito, Engenharias e Ciência da Computação\",\"jcr:description\":\"Cursos de graduação, pós-graduação e curta duração com qualidade reconhecida internacionalmente\",\"pageTitle\":\"Insper: Ensino Superior em Negócios, Direito, Engenharias e Ciência da Computação\",\"navTitle\":\"Insper - Home Page\"},{\"richText\":\"Entenda como a pós-graduação modular combina flexibilidade, personalização e desenvolvimento profissional para quem está no início da carreira.\",\"madeBy\":\"Por\",\"tag\":\"programas:pós-graduação\",\"buttonUrl\":\"https://www.insper.edu.br/pt/conteudos/gestao-e-negocios/pos-graduacao-modular-como-funciona-e-quais-sao-as-vantagens-para-jovens-profissionais\",\"title\":\"Pós-graduação modular: como funciona e quais são as vantagens para jovens profissionais\",\"variant\":\"imagecolor\",\"buttonText\":\"Acesse e saiba mais\",\"linkRedirect\":\"https://www.insper.edu.br/pt/conteudos/gestao-e-negocios/pos-graduacao-modular-como-funciona-e-quais-sao-as-vantagens-para-jovens-profissionais\"},{\"jcr:title\":\"vermelho / amarelo / preto\"},{\"themeName\":\"vermelho / amarelo / preto\",\"backgroundColor\":\"rgb(229,5,5)\"},{\"richText\":\"Parceria com a University of Chicago ganha novo capítulo com a chegada de um programa inédito voltado a estudantes do ensino médio no Brasil.\",\"madeBy\":\"Por\",\"tag\":\"tipos-de-conteudo:acontece-no-insper/parcerias\",\"buttonUrl\":\"https://www.insper.edu.br/pt/conteudos/acontece-no-insper/insper-celebra-25-anos-de-parceria-com-a-university-of-chicago-e-recebe-programa-inedito-para-ensino-medio-no-brasil\",\"title\":\"Insper celebra 25 anos de parceria com a University of Chicago e recebe programa inédito para ensino médio no Brasil\",\"variant\":\"imagecolor\",\"buttonText\":\"Saiba mais\",\"linkRedirect\":\"https://www.insper.edu.br/pt/conteudos/acontece-no-insper/insper-celebra-25-anos-de-parceria-com-a-university-of-chicago-e-recebe-programa-inedito-para-ensino-medio-no-brasil\"},{\"jcr:title\":\"turquesa / preto / vermelho\"},{\"themeName\":\"turquesa / preto / vermelho\"},{\"startHour\":\"19h00\",\"endHour\":\"20h30\",\"richText\":\"Um encontro sobre as transformações do mercado de trabalho e as competências essenciais para construir uma carreira preparada para o futuro.\",\"madeBy\":\"Por\",\"tag\":\"tipos-de-evento:online\",\"buttonUrl\":\"https://www.insper.edu.br/pt/eventos/2026/09/carreira-em-movimento-desafios-do-futuro\",\"title\":\"Carreira em movimento: como se preparar hoje para os desafios do futuro\",\"variant\":\"imagecolor\",\"buttonText\":\"Inscreva-se gratuitamente\",\"linkRedirect\":\"https://www.insper.edu.br/pt/eventos/2026/09/carreira-em-movimento-desafios-do-futuro\"},{\"jcr:title\":\"azul marinho / turquesa / vermelho\"},{\"@stringArray@variations_0\":\"azul_marinho_rosaturquesa\"},{\"jcr:title\":\"azul marinho / rosa / turquesa\",\"name\":\"azul_marinho_rosaturquesa\",\"jcr:description\":\"azul marinho / rosa / turquesa\"},{\"synchronizeWithVersion_0\":\"themeName:e1d1d653-cff0-4cbb-bae9-7676f42d5f08\",\"synchronizeWithVersion_1\":\"titleFontColor:e1d1d653-cff0-4cbb-bae9-7676f42d5f08\",\"synchronizeWithVersion_2\":\"titleBackgroundColor:e1d1d653-cff0-4cbb-bae9-7676f42d5f08\",\"synchronizeWithVersion_3\":\"thinLineFontColor:e1d1d653-cff0-4cbb-bae9-7676f42d5f08\",\"synchronizeWithVersion_4\":\"additionalDataFontColor:e1d1d653-cff0-4cbb-bae9-7676f42d5f08\",\"synchronizeWithVersion_5\":\"linkFontColor:e1d1d653-cff0-4cbb-bae9-7676f42d5f08\",\"synchronizeWithVersion_6\":\"linkHoverFontColor:e1d1d653-cff0-4cbb-bae9-7676f42d5f08\",\"synchronizeWithVersion_7\":\"backgroundColor:e1d1d653-cff0-4cbb-bae9-7676f42d5f08\",\"synchronizeWithVersion_8\":\"gradientColor:e1d1d653-cff0-4cbb-bae9-7676f42d5f08\",\"synchronizeWithVersion_9\":\"buttonFontColor:e1d1d653-cff0-4cbb-bae9-7676f42d5f08\",\"synchronizeWithVersion_10\":\"buttonBackgroundColor:e1d1d653-cff0-4cbb-bae9-7676f42d5f08\",\"synchronizeWithVersion_11\":\"tagFontColor:e1d1d653-cff0-4cbb-bae9-7676f42d5f08\",\"synchronizeWithVersion_12\":\"tagBackgroundColor:e1d1d653-cff0-4cbb-bae9-7676f42d5f08\"},{\"themeName\":\"azul marinho / turquesa / vermelho\"},{\"themeName\":\"azul marinho / rosa / turquesa\"},{\"linkIcon1\":\"icon-insper-return-arrow\",\"linkIcon2\":\"icon-insper-return-arrow\",\"richText\":\"Comece sua pós-graduação no Insper ainda em 2026. Entenda as vantagens.\",\"madeBy\":\"Por\",\"tag\":\"programas:pós-graduação\",\"buttonUrl\":\"https://www.insper.edu.br/pt/cursos/pos-graduacao\",\"title\":\"Por que deixar para 2027 o que você pode fazer agora pela sua carreira?\",\"variant\":\"imagecolor\",\"buttonText\":\"Conheça os cursos e inscreva-se\",\"linkRedirect\":\"https://www.insper.edu.br/pt/cursos/pos-graduacao\"},{\"jcr:title\":\"laranja - vermelho - turquesa\"},{\"themeName\":\"laranja - vermelho - turquesa\"},{\"startHour\":\"08h30\",\"endHour\":\"18h00\",\"richText\":\"Um programa de férias pensado para jovens mulheres do ensino médio que querem ampliar suas possibilidades de futuro e carreira na área de Finanças e Liderança. \",\"madeBy\":\"Por\",\"tag\":\"programas:programas-de-férias\",\"buttonUrl\":\"https://www.insper.edu.br/pt/cursos/ferias/women-in-finance-and-leadership\",\"title\":\"Women in Finance and Leadership\",\"variant\":\"imagecolor\",\"buttonText\":\"Inscreva-se e participe\",\"linkRedirect\":\"https://www.insper.edu.br/pt/cursos/ferias/women-in-finance-and-leadership\"},{\"jcr:title\":\"roxo - turquesa - amarelo\"},{\"themeName\":\"roxo - turquesa - vermelho\"},{\"linkIcon1\":\"icon-insper-return-arrow\",\"linkIcon2\":\"icon-insper-return-arrow\",\"richText\":\"Domine as decisões que fazem a diferença em uma operação de M&amp;A, da estratégia e valuation à negociação, aspectos jurídicos e integração.\",\"madeBy\":\"Por\",\"tag\":\"formato-de-programa:educa--o-executiva\",\"buttonUrl\":\"https://ee.insper.edu.br/cursos/estrategia-e-governanca/fusoes-e-aquisicoes/\",\"title\":\"Estratégia e Governança: Fusões e Aquisições\",\"variant\":\"imagecolor\",\"buttonText\":\"Conheça o curso\",\"linkRedirect\":\"https://ee.insper.edu.br/cursos/estrategia-e-governanca/fusoes-e-aquisicoes/\"},{\"jcr:title\":\"vermelho / preto / amarelo\"},{\"themeName\":\"vermelho / botao preto / tag amarelo\",\"backgroundColor\":\"rgb(229,5,5)\"},{\"containerType\":\"containerTwoEqual\"},{\"jcr:title\