y_images\":[{\"rid\":\"1758370868707401\",\"v\":[\"https://www.insper.edu.br/content/dam/insper-portal/imagens/educa%C3%A7%C3%A3o-executiva/educacao_executiva_01.jpg\",\"https://www.insper.edu.br/content/dam/insper-portal/imagens/institucional/Universidade%20de%20Chicago.jpg\",\"https://www.insper.edu.br/content/dam/insper-portal/imagens/aulas/mbm-Portfolio_Mkt%20Insper_Abril_2024_@dubillafoto_21021.jpg\",\"https://www.insper.edu.br/content/dam/insper-portal/imagens/aulas/Alunos%20da%20P%C3%B3s%20180bx.jpg\",\"https://www.insper.edu.br/content/dam/insper-portal/imagens/campus/jcr:content/cq:discarded/6fbd61ab-102a-4e4d-9513-4a95cd4add60/_FSC4996_PAGP.jpg\"]}],\"event_location\":[{\"rid\":\"1066170263088787\",\"v\":[\"Saiba como o Insper trata os seus dados pessoais em nosso Aviso de Privacidade, disponível no Portal da Privacidade.\"]},{\"rid\":\"1793128831824923\",\"v\":[\"Vestibular\",\"O Insper\"]}],\"author\":[{\"rid\":\"941938248530472\",\"v\":[\"O Insper\"]},{\"rid\":\"1632169591959885\",\"v\":[\"O Insper\"]},{\"rid\":\"1458044219514289\",\"v\":[\"O Insper\"]}],\"page_type\":[{\"rid\":\"1621346879668854\",\"v\":[\"Este website usa Cookies\"]},{\"rid\":\"2253166182083485\",\"v\":[\"EDUCAÇÃO EXECUTIVA\\n\\nEstratégia e Governança: Fusões e Aquisições\\n\\nDomine as decisões que fazem a diferença em uma operação de M&A, da estratégia e valuation à negociação, aspectos jurídicos e integração.\\n\\nConheça o curso\",\"PARCERIAS\\n\\nInsper celebra 25 anos de parceria com a University of Chicago e recebe programa inédito para ensino médio no Brasil\\n\\nParceria com a University of Chicago ganha novo capítulo com a chegada de um programa inédito voltado a estudantes do ensino médio no Brasil.\\n\\nSaiba mais\",\"PÓS-GRADUAÇÃO\\n\\nPós-graduação modular: como funciona e quais são as vantagens para jovens profissionais\\n\\nEntenda como a pós-graduação modular combina flexibilidade, personalização e desenvolvimento profissional para quem está no início da carreira.\\n\\nAcesse e saiba mais\",\"ON-LINE\\n\\nCarreira em movimento: como se preparar hoje para os desafios do futuro\\n\\n29 SET (TER)\\n\\n • 19h\\n\\n - 20h30\\n\\nUm encontro sobre as transformações do mercado de trabalho e as competências essenciais para construir uma carreira preparada para o futuro.\\n\\nInscreva-se gratuitamente\",\"PÓS-GRADUAÇÃO\\n\\nPor que deixar para 2027 o que você pode fazer agora pela sua carreira?\\n\\nComece sua pós-graduação no Insper ainda em 2026. Entenda as vantagens.\\n\\nConheça os cursos e inscreva-se\"]}],\"publisher\":[{\"rid\":\"1983600083026683\",\"v\":[\"Saiba como o Insper trata os seus dados pessoais em nosso Aviso de Privacidade, disponível no Portal da Privacidade.\"]},{\"rid\":\"2636101093516315\",\"v\":[\"Vestibular\",\"O Insper\"]},{\"rid\":\"1766810931204119\",\"v\":[\"Saiba como o Insper trata os seus dados pessoais em nosso Aviso de Privacidade, disponível no Portal da Privacidade.\"]}],\"entity_description\":[{\"rid\":\"3829285190562044\",\"v\":[\"Domine as decisões que fazem a diferença em uma operação de M&A, da estratégia e valuation à negociação, aspectos jurídicos e integração.\",\"Parceria com a University of Chicago ganha novo capítulo com a chegada de um programa inédito voltado a estudantes do ensino médio no Brasil.\",\"Entenda como a pós-graduação modular combina flexibilidade, personalização e desenvolvimento profissional para quem está no início da carreira.\",\"Um encontro sobre as transformações do mercado de trabalho e as competências essenciais para construir uma carreira preparada para o futuro.\",\"Comece sua pós-graduação no Insper ainda em 2026. Entenda as vantagens.\"]}],\"page_keywords\":[{\"rid\":\"1749191096301597\",\"v\":[\"Pesquisa\"]}]}\r\n------geckoformboundarybca3b97a0ae4dcd6526f12fcb7dae064\r\nContent-Disposition: form-data; name=\"imft\"\r\n\r\n1\r\n------geckoformboundarybca3b97a0ae4dcd6526f12fcb7dae064\r\nContent-Disposition: form-data; name=\"tz\"\r\n\r\n-180\r\n------geckoformbou